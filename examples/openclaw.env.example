# Environment for an OpenClaw agent that uses the mindthread skill.
# Install first:
#   npm install -g mindthread-cli
#   npx clawhub@latest install mindthread --workdir ~/.openclaw/workspace
MINDTHREAD_API_KEY=mt_test_your_key
# Optional: default account for commands that take -a (@handle or account id)
MINDTHREAD_ACCOUNT=@yourbrand
